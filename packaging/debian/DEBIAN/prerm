#!/bin/sh
set -e

case "$1" in
    remove|purge)
        # Remove DKMS module if registered
        if command -v dkms >/dev/null 2>&1; then
            DKMS_DIR=$(ls -d /usr/src/hid-lorgar-* 2>/dev/null | head -n 1)
            if [ -n "$DKMS_DIR" ]; then
                DKMS_VER=$(basename "$DKMS_DIR" | sed 's/^hid-lorgar-//')
                dkms remove -m hid-lorgar -v "$DKMS_VER" --all 2>/dev/null || true
            fi
        fi
        ;;
esac

exit 0
