[Unit]
Description=LORGAR MSA10W user control daemon
After=graphical-session.target

[Service]
ExecStart=%h/.local/bin/lorgard
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
TimeoutStopSec=5
LockPersonality=true
ProtectSystem=strict
ProtectHome=read-only
RuntimeDirectory=lorgar
ConfigurationDirectory=lorgar
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true

[Install]
WantedBy=default.target
