[Unit]
Description=LORGAR MSA10W user control daemon
Documentation=file:%h/Documents/ZZZZ/docs/control-stack.md
After=graphical-session.target
# Single HID owner: never run together with legacy direct-HID writers.
Conflicts=lorgarctl-tray.service lorgarctl-upower.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
ExecStart=%h/.local/bin/lorgard --restore-last-profile
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
TimeoutStopSec=5
LockPersonality=true
ProtectSystem=strict
ProtectHome=read-only
RuntimeDirectory=lorgar
RuntimeDirectoryMode=0700
ConfigurationDirectory=lorgar
ConfigurationDirectoryMode=0700
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true

[Install]
WantedBy=default.target
