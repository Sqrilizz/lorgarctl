[Unit]
Description=LORGAR MSA10W UPower Battery Daemon
Documentation=file:%h/Documents/ZZZZ/docs/control-stack.md
After=graphical-session.target
# Legacy direct-HID owner: conflicts with lorgard and tray.
Conflicts=lorgard.service lorgarctl-tray.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
ExecStart=%h/.local/bin/lorgarctl upower
Restart=on-failure
RestartSec=3s

[Install]
WantedBy=default.target
