# udev rules for LORGAR MSA10W gaming mouse (VID 093a, PID c600 / c601)
# Active local session access only. Explicit builtin also supports the legacy 99 filename.
ACTION!="remove", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="093a", ATTRS{idProduct}=="c600", MODE="0660", TAG+="uaccess", RUN{builtin}+="uaccess"
ACTION!="remove", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="093a", ATTRS{idProduct}=="c601", MODE="0660", TAG+="uaccess", RUN{builtin}+="uaccess"

# The composite interface exposes extra buttons as a keyboard. UPower otherwise
# gives that sibling priority over the real mouse and Plasma shows a keyboard
# battery icon. Keep the keyboard classification and additionally identify the
# interface as part of the mouse; UPower prefers mouse within one input node.
ACTION!="remove", SUBSYSTEM=="input", ATTRS{idVendor}=="093a", ATTRS{idProduct}=="c600", ENV{ID_USB_INTERFACE_NUM}=="01", ENV{ID_INPUT_MOUSE}="1"
ACTION!="remove", SUBSYSTEM=="input", ATTRS{idVendor}=="093a", ATTRS{idProduct}=="c601", ENV{ID_USB_INTERFACE_NUM}=="01", ENV{ID_INPUT_MOUSE}="1"

# Automatically bind to hid-lorgar kernel driver when plugged in or booted
ACTION=="add", SUBSYSTEM=="hid", DRIVERS=="hid-generic", ATTRS{idVendor}=="093a", ATTRS{idProduct}=="c600", RUN+="/bin/sh -c 'echo -n $kernel > /sys/bus/hid/drivers/hid-generic/unbind 2>/dev/null; modprobe hid-lorgar 2>/dev/null; echo -n $kernel > /sys/bus/hid/drivers/hid-lorgar/bind 2>/dev/null || true'"
ACTION=="add", SUBSYSTEM=="hid", DRIVERS=="hid-generic", ATTRS{idVendor}=="093a", ATTRS{idProduct}=="c601", RUN+="/bin/sh -c 'echo -n $kernel > /sys/bus/hid/drivers/hid-generic/unbind 2>/dev/null; modprobe hid-lorgar 2>/dev/null; echo -n $kernel > /sys/bus/hid/drivers/hid-lorgar/bind 2>/dev/null || true'"
