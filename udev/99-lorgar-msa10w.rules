# udev rules for LORGAR MSA10W gaming mouse (VID 093a, PID c600 / c601)
# Active local session access only. Explicit builtin also supports the legacy 99 filename.
ACTION!="remove", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="093a", ATTRS{idProduct}=="c600", MODE="0660", TAG+="uaccess", RUN{builtin}+="uaccess"
ACTION!="remove", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="093a", ATTRS{idProduct}=="c601", MODE="0660", TAG+="uaccess", RUN{builtin}+="uaccess"
