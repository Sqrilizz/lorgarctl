# udev rules for LORGAR MSA10W gaming mouse (VID 093a, PID c600 / c601)
# Allows logged-in desktop user access to hidraw configuration interfaces without sudo.

KERNEL=="hidraw*", ATTRS{idVendor}=="093a", ATTRS{idProduct}=="c600", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", ATTRS{idVendor}=="093a", ATTRS{idProduct}=="c601", MODE="0660", TAG+="uaccess"
